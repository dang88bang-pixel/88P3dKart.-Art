# Direct edge-agent launch template. Copy to an untracked secret source; never
# commit real values. Docker Compose uses root .env.example plus Docker secrets.
AGENT_DB_PATH=/data/agent.db
AGENT_AUTH_DB_PATH=/data/credentials.db
AGENT_ALARM_DB_PATH=/data/alarms.db
# Stable bounded deployment identity used in authoritative alarm events.
AGENT_GATEWAY_ID=gateway-site-01
AGENT_ALARM_TICK_MS=250
AGENT_ALARM_OUTBOX_LEASE_MS=30000
AGENT_ALARM_OUTBOX_RETRY_MS=5000
AGENT_ALARM_OUTBOX_BATCH_SIZE=100

# Independently generated values, each at least 32 characters. Prefer *_FILE.
AGENT_AUTH_SIGNING_SECRET_FILE=/run/secrets/agent-signing-secret
AGENT_ADMIN_BOOTSTRAP_TOKEN_FILE=/run/secrets/agent-admin-token
AGENT_SESSION_TTL_SECONDS=900
AGENT_AUTH_MAX_FAILURES=5
AGENT_AUTH_FAILURE_WINDOW_SECONDS=60
AGENT_AUTH_ATTEMPT_MAX_KEYS=4096

# Direct launch is HTTPS/WSS by default. In Compose, only nginx is externally
# reachable and this internal hop is explicitly configured without TLS.
AGENT_REQUIRE_TLS=true
AGENT_TLS_CERTFILE=/run/secrets/gateway-cert.pem
AGENT_TLS_KEYFILE=/run/secrets/gateway-key.pem
AGENT_TRUSTED_HOSTS=gateway.example.internal
AGENT_CORS_ORIGINS=https://console.example.internal
AGENT_MAX_HTTP_BODY_BYTES=4194304
AGENT_MAX_WEBSOCKET_MESSAGE_BYTES=1048576

# MQTT remains disabled unless a CA plus either complete username/password or
# complete client-certificate credentials are supplied. Prefer mTLS on 8883.
AGENT_MQTT_ENABLED=false
MQTT_HOST=mqtt.example.internal
MQTT_PORT=8883
AGENT_MQTT_TLS_CA=/run/secrets/mqtt-ca.pem
AGENT_MQTT_TLS_CERT=/run/secrets/mqtt-client.pem
AGENT_MQTT_TLS_KEY=/run/secrets/mqtt-client-key.pem
# Optional alternative for a password-authenticated TLS listener:
# AGENT_MQTT_USERNAME=edge-agent
# AGENT_MQTT_PASSWORD_FILE=/run/secrets/mqtt-password
