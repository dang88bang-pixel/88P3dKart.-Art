{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3dxagent.local/schemas/command-intent/1.0.0",
  "title": "3dxAgent CommandIntent",
  "description": "Short-lived, signed and idempotent control-plane intent from an operator session to one gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "correlation_id",
    "actor_session_id",
    "gateway_id",
    "resource",
    "action",
    "expected_revision",
    "issued_at",
    "expires_at",
    "parameters",
    "policy_version",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "gateway_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "resource": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*(/[a-zA-Z0-9._:-]+)+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm", "key_id", "value"],
      "properties": {
        "format": {
          "enum": ["COSE_SIGN1", "JWS_COMPACT"]
        },
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9._~-]+$"
        }
      }
    }
  }
}
