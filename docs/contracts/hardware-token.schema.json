{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3dxagent.local/schemas/hardware-token-claims/1.0.0",
  "title": "3dxAgent HardwareTokenClaims",
  "description": "Signed authorization claims for an enrolled hardware token. This document never contains private key material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token_id",
    "issuer",
    "subject_hardware_id",
    "audience_master_id",
    "issued_at",
    "not_before",
    "expires_at",
    "role",
    "permissions",
    "token_type",
    "mesh_members",
    "key_id",
    "token_version",
    "revocation_epoch"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "token_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "subject_hardware_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "audience_master_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "vehicle_id": {
      "type": ["string", "null"],
      "maxLength": 160
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "enum": ["DRIVER", "WORKSHOP", "PROGRAMMING", "ENGINEERING"]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "assurance_class": {
      "enum": ["A0", "A1", "A2", "A3"]
    },
    "token_type": {
      "enum": ["SINGLE", "GROUP"]
    },
    "mesh_members": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "token_version": {
      "type": "integer",
      "minimum": 1
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "maxLength": 80
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "token_type": {
            "const": "SINGLE"
          }
        }
      },
      "then": {
        "properties": {
          "mesh_members": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token_type": {
            "const": "GROUP"
          }
        }
      },
      "then": {
        "properties": {
          "mesh_members": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
