# 3dxAgent — Beispielkonfiguration
# Kopieren nach .env und anpassen. .env gehört NICHT ins Repository.

# ─────────────────────────────────────────────────────────────
#  Basis
# ─────────────────────────────────────────────────────────────
AGENT_DB_PATH=/data/agent.db
AGENT_LOG_DIR=/var/log/agent
AGENT_LOOP_HZ=20
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ─────────────────────────────────────────────────────────────
#  Georeferenzierung (v4.5.0-Geo)
# ─────────────────────────────────────────────────────────────
GEO_ENABLED=true

# WICHTIG: true = es verlässt kein Scan-Ergebnis das Gerät.
# Auf false zu setzen bedeutet, dass die WLAN-/Zell-Umgebung des
# Einsatzorts an einen fremden Server übertragen wird. Das ist eine
# Verarbeitung personenbeziehbarer Daten und braucht eine Rechtsgrundlage.
GEO_OFFLINE_ONLY=true

# Reihenfolge der Provider-Kaskade. Verfügbar:
#   offline_cell    Tier 0, lokale OpenCelliD-SQLite, kein Netzverkehr
#   beacondb        Tier 2, api.beacondb.net (AGPL-3.0, experimentell)
#   local_ichnaea   Tier 1, selbst gehostete Ichnaea-Instanz
#   combain         Tier 2, kommerziell, auch als On-Premise-Appliance
#   google          Tier 2, kommerziell, siehe Cache-Beschränkung unten
GEO_PROVIDER_CHAIN=offline_cell,beacondb

# 0.35 entspricht rund 400 m Genauigkeit.
# Nicht höher setzen: 0.5 verlangt <=100 m, das erreicht reine
# Zellortung (>=150 m) nie — die Offline-Kette liefe leer.
GEO_MIN_QUALITY=0.35
GEO_CACHE_TTL_S=300
GEO_TIMEOUT_S=4.0
GEO_USER_AGENT=3dxAgent/4.5 (+https://github.com/dang88bang-pixel/88P3dKart.-Art)

# Offline-Zelldatenbank. Aufbau mit: python scripts/fetch_geo_data.py
# Quelle OpenCelliD, CC BY-SA 4.0 — Namensnennung ist Pflicht (docs/LICENSES.md).
GEO_OFFLINE_CELL_DB=/data/opencellid.sqlite

# beaconDB — Nachfolger des abgeschalteten Mozilla Location Service.
# Kein API-Key nötig, aber ausdrücklich experimentell (keine Verfügbarkeitszusage).
GEO_BEACONDB_URL=https://api.beacondb.net/v1/geolocate

# Selbst gehostete Ichnaea-Instanz (Apache-2.0) — bevorzugt, wenn die
# Datenhoheit beim Betreiber bleiben muss.
GEO_LOCAL_ICHNAEA_URL=

# Combain: einziger geprüfter Anbieter mit echter On-Premise-Option.
GEO_COMBAIN_URL=
GEO_COMBAIN_KEY=

# Google Geolocation API. Achtung:
#  - der 200-USD-Freibetrag entfiel zum 01.03.2025
#  - die ToS erlauben Zwischenspeicherung von lat/lng nur bis 30 Tage
#    (durchgesetzt über geo_fixes.expires_at + purge_expired_geo())
#  - "No Use With any Map" ausser Google Maps
GEO_GOOGLE_KEY=
GEO_GOOGLE_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────
#  Externe Tracking-Feeds (Stufe 1: nur GTFS-Realtime)
# ─────────────────────────────────────────────────────────────
# Standard aus. Vor dem Einschalten klären:
#  1. Lizenz des Feeds (Namensnennung? Weitergabe erlaubt?)
#  2. Zweckbindung — Daten für Fahrgastinformation sind nicht
#     automatisch für ein behördliches Lagebild freigegeben
#  3. eine Bounding-Box-Anfrage verrät den Einsatzort an den Feed-Betreiber
EXT_ENABLED=false
EXT_SOURCES=gtfs_rt

# Nur Entitäten innerhalb dieses Radius um den GeoAnchor werden ausgeliefert.
EXT_RADIUS_M=2000

# Ab diesem Alter gilt eine Entität als veraltet (quality faellt auf 0).
# 120 s sind bei 50 km/h bereits rund 1,7 km Positionsfehler.
EXT_MAX_AGE_S=120
EXT_MIN_QUALITY=0.3
EXT_MAX_ENTITIES=500

# GTFS-Realtime VehiclePositions-Endpunkt (Protobuf).
# Beispiele: DELFI, MobiData BW, VBB. Feed-Verzeichnis: Mobility Database
# (TransitFeeds wird im Dezember 2025 abgeschaltet).
GTFS_RT_URL=
GTFS_RT_POLL_S=20
GTFS_RT_API_KEY=
GTFS_RT_API_KEY_HEADER=Authorization

# Pflichtangaben zur Anzeige in der Oberfläche.
GTFS_RT_LICENSE=unknown
GTFS_RT_ATTRIBUTION=
