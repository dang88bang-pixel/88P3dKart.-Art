# Docker Compose deployment metadata only; credentials belong in ./secrets.
AGENT_PUBLIC_HOST=gateway.example.internal
# Stable identity written into authoritative alarm events; do not recycle across sites.
AGENT_GATEWAY_ID=gateway-site-01
# Numeric host group that owns /dev/ttyUSB0 and /dev/ttyACM0 (often dialout).
AGENT_DEVICE_GID=20
# MQTT is opt-in and additionally requires: docker compose --profile mqtt up -d
AGENT_MQTT_ENABLED=false
